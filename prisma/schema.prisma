generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  email         String     @unique
  password      String
  cpf           String     @unique @db.VarChar(11)
  role String     @default("USER") 
  birthday  DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@map("users") 
}

model Representative {
  id               Int                @id @default(autoincrement())
  name             String
  cpf              String
  academic_entity_role String
  phone            String
  email            String
  cep              String
  status           String

  @@map("representatives")
}

enum AcademicEntityType {
  ACADEMIC_CENTER
  CENTRAL_DIRECTORY
  ATHLETICS
}

model AcademicEntity {
  id               Int         @id @default(autoincrement())
  type             AcademicEntityType
  fantasyName      String
  cnpj             String      @unique
  foundationDate   DateTime
  status           String
  cep              String
  representativeId Int

  @@map("academic_entities") 
}

model Campaign {
  id               Int         @id @default(autoincrement())
  name             String
  goal             Float
  startDate        DateTime
  endDate          DateTime
  academicEntityId Int

  @@map("campaigns")
}

model Donation {
  id          Int       @id @default(autoincrement())
  donated     Float
  date        DateTime
  userId      Int
  campaignId  Int

  @@map("donations")
}
